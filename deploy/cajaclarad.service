[Unit]
Description=CajaClara - Demonio de extracción de facturas IMAP
Documentation=https://github.com/tu-org/caja-clara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cajaclarad
Group=cajaclarad
EnvironmentFile=/etc/cajaclarad/env

# Asegurar que se ejecuta uv run en el entorno desplegado
WorkingDirectory=/opt/cajaclarad
ExecStart=/usr/local/bin/uv run cajaclarad

# Resiliencia y Control de Memoria (Cgroups v2: RAM < 45MB)
MemoryMax=45M
MemoryHigh=40M
MemorySwapMax=0
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

# Hardening / Seguridad
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/cajaclarad /var/log/cajaclarad

# Logging a journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cajaclarad

[Install]
WantedBy=multi-user.target
