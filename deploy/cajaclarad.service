[Unit]
Description=CajaClara - Demonio de extracción de facturas IMAP
Documentation=https://github.com/tu-org/caja-clara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cajaclarad
Group=cajaclarad
EnvironmentFile=/etc/cajaclarad/env

# Asegurar que se ejecuta uv run en el entorno desplegado
WorkingDirectory=/opt/cajaclarad
ExecStart=/usr/local/bin/uv run cajaclarad

# Resiliencia
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

# Opcional para Fase 2
# WatchdogSec=300

# Hardening / Seguridad
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/cajaclarad /var/log/cajaclarad

# Logging a journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cajaclarad

[Install]
WantedBy=multi-user.target
